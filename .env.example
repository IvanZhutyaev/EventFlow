# EventFlow configuration reference (spec §23).
# Copy to .env and adjust; never commit real secrets.

APP_ENV=development
HTTP_PORT=8080

DATABASE_URL=postgres://eventflow:eventflow@localhost:5432/eventflow?sslmode=disable
NATS_URL=nats://localhost:4222

WORKER_CONCURRENCY=20
MAX_DELIVERY_ATTEMPTS=5
REQUEST_TIMEOUT=10s
SHUTDOWN_TIMEOUT=15s

# Retry policy (exponential backoff, spec §9)
RETRY_INITIAL_DELAY=5s
RETRY_MAX_DELAY=30m
RETRY_MULTIPLIER=2

# Rate limiting: requests per second per project (spec §16)
RATE_LIMIT_RPS=100

# HMAC-SHA256 secret for webhook signing (spec §12)
WEBHOOK_SECRET=change-me

# Admin token for the bootstrap API (POST /api/v1/projects)
ADMIN_TOKEN=change-me

# Validation limits (spec §26)
MAX_SUBSCRIPTIONS_PER_PROJECT=100
MAX_EVENT_BODY_BYTES=1048576